# ==============================================================================
# VibeMatch Event Quiz — Environment Configuration
# ==============================================================================

# --- AI Matcher (DeepSeek / OpenAI compatible API) ---
# DeepSeek API Key (https://platform.deepseek.com or compatible provider)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Database ---
DB_PATH=backend/database/events.db

# --- Server / API ---
PORT=8080
HOST=0.0.0.0

# --- Telegram Bot & Subscription Gate ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Channel username with '@' or numeric chat_id where subscription is required
TELEGRAM_CHANNEL_ID=@your_channel_username
TELEGRAM_BOT_USERNAME=your_event_matcher_bot
BACKEND_INTERNAL_URL=http://backend:8080

# --- MAX Messenger Integration ---
MAX_BOT_TOKEN=your-max-bot-token
MAX_COMMUNITY_ID=your-max-group-id
